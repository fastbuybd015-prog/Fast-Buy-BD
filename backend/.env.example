# =============================================================================
# FastShopBD — Backend Environment Variables
# =============================================================================
#
# HOW TO USE
#   1. Copy this file:      cp .env.example .env
#   2. Fill in the values below.
#   3. Start the server:    bun run dev
#
# RULES
#   - NEVER commit .env  (it is git-ignored).
#   - NEVER expose any value from this file to the browser/frontend.
#     Only frontend/.env.local + NEXT_PUBLIC_* variables are browser-safe.
#   - Variables marked [REQUIRED] must be set before running in production.
#     In development the server still boots without them, but any feature
#     that depends on them will return 503 SERVICE_UNAVAILABLE.
#
# =============================================================================


# -----------------------------------------------------------------------------
# 1. APPLICATION
# -----------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Port the Fastify server listens on.
# Keep it different from the Next.js frontend (which uses 3000).
PORT=4000

# Network interface to bind. Leave as-is for local development.
HOST=0.0.0.0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# 2. CORS / FRONTEND ORIGIN
# -----------------------------------------------------------------------------
# The backend only accepts browser requests from these origins.
# Wildcard "*" is intentionally NOT supported for an authenticated API.

# Your Next.js frontend URL.
#   local:      http://localhost:3000
#   production: https://fastshopbd.vercel.app
FRONTEND_URL=http://localhost:3000

# Optional. Extra allowed origins, comma-separated (no spaces).
# Useful for Vercel preview deployments or a second local port.
# Example: https://fastshopbd-git-dev.vercel.app,http://localhost:3001
ADDITIONAL_CORS_ORIGINS=


# -----------------------------------------------------------------------------
# 3. DATABASE — Supabase PostgreSQL          [REQUIRED]
# -----------------------------------------------------------------------------
# Where to find it:
#   Supabase Dashboard -> your project -> Connect -> ORMs / Drizzle
#
# IMPORTANT — pick the right connection string:
#   - Local development  -> "Session pooler"     (port 5432)
#   - Vercel/serverless  -> "Transaction pooler" (port 6543)
#
# If you use the Transaction pooler (6543), you MUST also append:
#   ?prepare=false
# because transaction-mode pooling does not support prepared statements.
#
# Format:
#   postgresql://postgres.<project-ref>:<db-password>@<host>:<port>/postgres
#
# If your database password contains special characters (@ : / ? # & %),
# URL-encode them. Example: "p@ss" -> "p%40ss"
DATABASE_URL=


# -----------------------------------------------------------------------------
# 4. SUPABASE AUTH / STORAGE          [REQUIRED]
# -----------------------------------------------------------------------------
# Where to find these:
#   Supabase Dashboard -> Project Settings -> API Keys

# Your project URL. Example: https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Publishable ("anon") key.
# Safe for browsers — protected by Row Level Security.
# The backend uses it only for user-scoped operations.
SUPABASE_PUBLISHABLE_KEY=

# Secret ("service_role") key.
# !! FULL ADMIN ACCESS — BYPASSES ROW LEVEL SECURITY !!
# Server-side only. Never send this to the frontend, never commit it,
# never log it. Rotate it immediately if it ever leaks.
SUPABASE_SECRET_KEY=


# -----------------------------------------------------------------------------
# 5. SUPABASE STORAGE BUCKETS
# -----------------------------------------------------------------------------
# Bucket names used for file uploads. Create them in:
#   Supabase Dashboard -> Storage
#
# Recommended visibility:
#   product images / store logos / banners -> PUBLIC
#   payment proof screenshots              -> PRIVATE  (signed URLs only)

SUPABASE_BUCKET_PRODUCT_IMAGES=product-images
SUPABASE_BUCKET_STORE_LOGOS=store-logos
SUPABASE_BUCKET_AVATARS=avatars
SUPABASE_BUCKET_PAYMENT_PROOFS=payment-proofs


# -----------------------------------------------------------------------------
# 6. REDIS  (optional — caching & rate limiting)
# -----------------------------------------------------------------------------
# Redis is OPTIONAL. If left empty, the backend runs normally and simply
# skips caching — PostgreSQL always stays the source of truth.
#
# Options:
#   Local Docker:  redis://localhost:6379
#   Upstash:       rediss://default:<password>@<host>.upstash.io:6379
#                  (note: "rediss://" with two s = TLS)
REDIS_URL=


# -----------------------------------------------------------------------------
# 7. API DOCUMENTATION
# -----------------------------------------------------------------------------
# Expose Swagger UI at /docs.
# Enabled by default in development; set to "true" to also expose it in
# production (useful for the university defense demo).
ENABLE_SWAGGER=true
